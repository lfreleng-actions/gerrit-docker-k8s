# SPDX-License-Identifier: Apache-2.0
# SPDX-FileCopyrightText: 2026 The Linux Foundation

# Gerrit image for the Helm chart: the image Dockerfile builds, plus
# the plugin catalogue the chart's site-init copies from, and rclone,
# which site-import's s3 source fetches an export with.
#
# The catalogue lives outside the site, at /var/gerrit-catalogue (the
# chart's pluginCatalogue.path default), as plugins/<name>.jar and
# lib/<name>.jar:
# - the jars docker/plugins.lock pins, which this build does not
#   download: scripts/fetch-plugin-catalogue.sh prepares them in
#   build/plugin-catalogue, from the signed GHCR mirror or, for a lock
#   not yet mirrored, from GerritForge. The build checks them against
#   the lock's sha256 again; a mismatch fails it
# - a symlink to /var/gerrit/plugins/<name>.jar for each core plugin
#   the official image bundles; site-init mounts the site elsewhere,
#   so it sees the image's own /var/gerrit, and its cp follows them
#
# Nothing here touches /var/gerrit/plugins, so a container started
# from this image without the chart behaves as the base image does.
#
# Build (the base first, then the catalogue, then this file):
#   docker build -t gerrit-extended:local .
#   bash scripts/fetch-plugin-catalogue.sh build/plugin-catalogue
#   docker build -f Dockerfile.chart \
#     --build-arg BASE_IMAGE=gerrit-extended:local -t gerrit-chart:local .

ARG BASE_IMAGE=gerrit-extended:local
# hadolint ignore=DL3006
FROM ${BASE_IMAGE}

LABEL org.opencontainers.image.title="Gerrit for Kubernetes"
LABEL org.opencontainers.image.description="Gerrit Code Review with uv, gerrit-to-platform and a plugin catalogue for the Helm chart"
LABEL org.opencontainers.image.source="https://github.com/lfreleng-actions/gerrit-docker-k8s"
LABEL org.opencontainers.image.licenses="Apache-2.0"

USER root

ENV GERRIT_CATALOGUE=/var/gerrit-catalogue
COPY docker/plugins.lock /tmp/plugins.lock
COPY docker/fetch-plugins.sh /tmp/fetch-plugins.sh
# COPY makes everything root-owned and keeps the modes the fetch
# script set (0644 files, 0755 directories); the RUN below checks them
# rather than changing them, which would copy every jar into a second
# layer.
COPY build/plugin-catalogue/ ${GERRIT_CATALOGUE}/

# Each lock line is "<dir>/<name> <url> <sha256>"; see the lock file.
# fetch-plugins.sh --check downloads nothing: it checks every jar
# against the lock and that no other jar is present.
RUN set -eu; \
    sh /tmp/fetch-plugins.sh --check /tmp/plugins.lock "$GERRIT_CATALOGUE"; \
    bad=$(find "$GERRIT_CATALOGUE" \( ! -user root -o ! -group root \
        -o \( -type d ! -perm 0755 \) -o \( ! -type d ! -perm 0644 \) \) -print); \
    if [ -n "$bad" ]; then \
        echo "Not root-owned with mode 0644 (files) or 0755 (directories):" >&2; \
        echo "$bad" >&2; \
        exit 1; \
    fi; \
    for core in /var/gerrit/plugins/*.jar; do \
        link="$GERRIT_CATALOGUE/plugins/${core##*/}"; \
        if [ ! -e "$link" ]; then ln -s "$core" "$link"; fi; \
    done; \
    for name in replication hooks webhooks delete-project download-commands; do \
        test -f "$GERRIT_CATALOGUE/plugins/$name.jar"; \
    done; \
    rm -f /tmp/plugins.lock /tmp/fetch-plugins.sh; \
    ls -l "$GERRIT_CATALOGUE/plugins" "$GERRIT_CATALOGUE/lib"

# --- rclone: the S3 client for the chart's site-import s3 source -------------
# Only this image carries it; the GitHub Action's image does not.
# fetch-rclone.sh checks the release archive against TOOL_RCLONE_SHA256
# and against the release's SHA256SUMS, and fails the build on a
# mismatch. The release image is linux/amd64 only, as is the pinned
# archive.
#
# No build arg or ENV may start with RCLONE_: rclone reads every
# RCLONE_<FLAG> variable as that flag, so RCLONE_VERSION in the
# environment of "rclone version" would set --version and fail.
#
# To update: set TOOL_RCLONE_VERSION to the release tag, then take the
# archive's digest from the release's SHA256SUMS:
#   curl -fsSL https://github.com/rclone/rclone/releases/download/<VERSION>/SHA256SUMS \
#     | grep 'linux-amd64.zip$'
ARG TOOL_RCLONE_VERSION=v1.76.0
ARG TOOL_RCLONE_SHA256=b00f00b3266c3764413afe599d3ec316f6f43b3e0ea8a0bc1d186d2133e46df7
COPY docker/fetch-rclone.sh /tmp/fetch-rclone.sh
RUN set -eu; \
    sh /tmp/fetch-rclone.sh "$TOOL_RCLONE_VERSION" "$TOOL_RCLONE_SHA256" /usr/local/bin; \
    rm -f /tmp/fetch-rclone.sh; \
    rclone version

USER gerrit
