[rule "comment-on-change-created"]
	event-type = patchset-created
	patchSetNumber = 1
	action = add-standard-comment
[rule "comment-on-change-merged"]
	event-type = change-merged
	action = add-standard-comment
[rule "comment-on-change-abandoned"]
	event-type = change-abandoned
	action = add-standard-comment
[rule "resolve"]
	event-type = comment-added
	action = In Review
