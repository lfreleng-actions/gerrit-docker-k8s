[gerrit]
	basePath = git
	canonicalWebUrl = https://gerrit.example.org/r/
[httpd]
	listenUrl = proxy-https://*:8080/r/
[sshd]
	advertisedAddress = gerrit.example.org:29418
	listenAddress = *:29418
[auth]
	type = DEVELOPMENT_BECOME_ANY_ACCOUNT
[sendemail]
	enable = false
[container]
	javaOptions = "-Dflogger.backend_factory=com.google.common.flogger.backend.log4j.Log4jBackendFactory#getInstance"
	javaOptions = "-Dflogger.logging_context=com.google.gerrit.server.logging.LoggingContext#getInstance"
	javaOptions = -Djava.security.egd=file:/dev/./urandom
	javaOptions = --add-opens java.base/java.net=ALL-UNNAMED
	javaOptions = --add-opens java.base/java.lang.invoke=ALL-UNNAMED
	javaOptions = -XX:MaxRAMPercentage=70.0
	user = gerrit
[cache]
	directory = cache
[cache "comment_context"]
	diskLimit = 128m
[cache "conflicts"]
	diskLimit = 128m
[cache "diff_intraline"]
	diskLimit = 512m
[cache "diff_summary"]
	diskLimit = 1g
[cache "gerrit_file_diff"]
	diskLimit = 1g
[cache "git_file_diff"]
	diskLimit = 1g
[cache "git_modified_files"]
	diskLimit = 512m
[cache "modified_files"]
	diskLimit = 1g
[gc]
	interval = 1 week
	startTime = Sun 03:00
[plugins]
	allowRemoteAdmin = false
[hooks]
	path = /var/gerrit/hooks
	syncHookTimeout = 45
