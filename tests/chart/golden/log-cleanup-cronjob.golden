---
# Source: gerrit/templates/log-cleanup-cronjob.yaml
# The log cleanup pod needs no network: deny all ingress and egress
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: gerrit-log-cleanup-deny
  namespace: gerrit-test
  labels:
    helm.sh/chart: gerrit-0.1.0
    app.kubernetes.io/name: gerrit-log-cleanup
    app.kubernetes.io/instance: gerrit
    app.kubernetes.io/component: log-cleanup
    app.kubernetes.io/version: "3.13.1"
    app.kubernetes.io/managed-by: Helm
    app.kubernetes.io/part-of: gerrit
spec:
  podSelector:
    matchLabels:
      app.kubernetes.io/name: gerrit-log-cleanup
      app.kubernetes.io/instance: gerrit
      app.kubernetes.io/component: log-cleanup
  policyTypes:
    - Ingress
    - Egress
---
# Source: gerrit/templates/log-cleanup-cronjob.yaml
# Deletes the rotated logs under logs/ on the site volume once they
# are older than logs.retentionDays
apiVersion: batch/v1
kind: CronJob
metadata:
  name: gerrit-log-cleanup
  namespace: gerrit-test
  labels:
    helm.sh/chart: gerrit-0.1.0
    app.kubernetes.io/name: gerrit-log-cleanup
    app.kubernetes.io/instance: gerrit
    app.kubernetes.io/component: log-cleanup
    app.kubernetes.io/version: "3.13.1"
    app.kubernetes.io/managed-by: Helm
    app.kubernetes.io/part-of: gerrit
spec:
  schedule: "30 4 * * *"
  concurrencyPolicy: Forbid
  successfulJobsHistoryLimit: 3
  failedJobsHistoryLimit: 3
  jobTemplate:
    spec:
      backoffLimit: 0
      template:
        metadata:
          labels:
            helm.sh/chart: gerrit-0.1.0
            app.kubernetes.io/name: gerrit-log-cleanup
            app.kubernetes.io/instance: gerrit
            app.kubernetes.io/component: log-cleanup
            app.kubernetes.io/version: "3.13.1"
            app.kubernetes.io/managed-by: Helm
            app.kubernetes.io/part-of: gerrit
          annotations:
            instrumentation.opentelemetry.io/inject-java: "false"
            instrumentation.opentelemetry.io/inject-nodejs: "false"
            instrumentation.opentelemetry.io/inject-python: "false"
            instrumentation.opentelemetry.io/inject-dotnet: "false"
            instrumentation.opentelemetry.io/inject-go: "false"
            instrumentation.opentelemetry.io/inject-sdk: "false"
        spec:
          restartPolicy: Never
          automountServiceAccountToken: false
          securityContext:
            runAsNonRoot: true
            runAsUser: 1001
            runAsGroup: 1001
            fsGroup: 1001
            fsGroupChangePolicy: OnRootMismatch
            seccompProfile:
              type: RuntimeDefault
          # The site volume is usually ReadWriteOnce: run only on the
          # node Gerrit runs on, where the volume is already attached
          affinity:
            podAffinity:
              requiredDuringSchedulingIgnoredDuringExecution:
                - topologyKey: kubernetes.io/hostname
                  labelSelector:
                    matchLabels:
                      app.kubernetes.io/name: gerrit
                      app.kubernetes.io/instance: gerrit
          containers:
            - name: log-cleanup
              image: ghcr.io/lfreleng-actions/gerrit:3.13.1
              imagePullPolicy: IfNotPresent
              command: ["sh", "/scripts/log-cleanup.sh"]
              env:
                - name: GERRIT_SITE
                  value: /var/gerrit
                - name: LOG_RETENTION_DAYS
                  value: "30"
                - name: HOME
                  value: /tmp
              securityContext:
                allowPrivilegeEscalation: false
                readOnlyRootFilesystem: true
                runAsNonRoot: true
                capabilities:
                  drop:
                    - ALL
              volumeMounts:
                - name: site
                  mountPath: /var/gerrit
                - name: scripts
                  mountPath: /scripts
                  readOnly: true
                - name: tmp
                  mountPath: /tmp
          volumes:
            - name: site
              persistentVolumeClaim:
                claimName: site-gerrit-0
            - name: scripts
              configMap:
                name: gerrit-scripts
            - name: tmp
              emptyDir: {}
